@model IEnumerable<CategoriesProducts.Models.Product>

@{
    ViewData["Title"] = "Products";
}

<h1>Products</h1>

<a asp-action="Create"
   class="btn btn-primary mb-3">
    Add Product
</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Price</th>
            <th>Category</th>
            <th>Image</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var product in Model)
        {
            <tr>
                <td>@product.Id</td>

                <td>@product.Name</td>

                <td>@product.Price</td>

                <td>@product.Category.Name</td>

                <td>
                    <img src="@product.ImagePath"
                         width="100"
                         height="100" />
                </td>
            </tr>
        }

    </tbody>
</table>