@model IEnumerable<CategoriesProducts.Models.Category>

@{
    ViewData["Title"] = "Categories";
}

<h1>Categories</h1>

<a asp-action="Create"
   class="btn btn-primary mb-3">
    Add Category
</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Image</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var category in Model)
        {
            <tr>
                <td>@category.Id</td>

                <td>@category.Name</td>

                <td>
                    <img src="@category.ImagePath"
                         width="100"
                         height="100" />
                </td>
            </tr>
        }

    </tbody>
</table>